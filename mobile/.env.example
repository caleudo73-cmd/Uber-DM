# Copia este archivo a mobile/.env y completa con los datos de tu proyecto Firebase.
# Firebase Console -> Configuración del proyecto -> Tus apps -> Configuración del SDK.
# Nunca subas mobile/.env al repositorio.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: Google Distance Matrix (distancia y duración reales del viaje).
# Sin esta llave la app usa distancia en línea recta y duración estimada.
# Restringe la llave a la app Android/iOS y a Distance Matrix API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
