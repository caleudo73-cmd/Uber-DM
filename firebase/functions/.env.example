# Variables del backend de pagos. Copia este archivo a firebase/functions/.env
# Access token de PRUEBA de Mercado Pago (nunca el de producción).
MERCADO_PAGO_ACCESS_TOKEN=
# URL pública de la Cloud Function que recibe el webhook.
MERCADO_PAGO_WEBHOOK_URL=
# URL a la que Mercado Pago devuelve al usuario después de pagar.
MERCADO_PAGO_BACK_URL=
# Stripe solo en modo de prueba (opcional).
STRIPE_SECRET_KEY=
