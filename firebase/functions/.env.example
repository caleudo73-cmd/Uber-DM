# Variables del backend de pagos. Copia este archivo a firebase/functions/.env
# Ese archivo está en .gitignore: nunca subas credenciales al repositorio.

# Access token de PRUEBA de Mercado Pago (nunca el de producción).
# Se obtiene en https://www.mercadopago.com.co/developers/panel/app
# -> tu aplicación -> Credenciales de prueba.
MERCADO_PAGO_ACCESS_TOKEN=

# Clave secreta del webhook (Mercado Pago -> Webhooks -> Firma secreta).
# Si queda vacía, el webhook acepta notificaciones sin validar la firma.
MERCADO_PAGO_WEBHOOK_SECRET=

# true (por defecto) abre el checkout de pruebas (sandbox_init_point).
# Para cobrar de verdad, cámbialo a false y usa credenciales de producción.
MERCADO_PAGO_SANDBOX=true

# Opcionales. Si no se definen, se usan las URLs públicas de Cloud Functions:
# https://us-central1-uberclone-7afa6.cloudfunctions.net/mercadoPagoWebhook
# https://us-central1-uberclone-7afa6.cloudfunctions.net/paymentReturn
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_BACK_URL=
