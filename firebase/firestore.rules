// AI-assisted: see docs/AI_LOG.md #8, #9
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Perfil del usuario. El rol y el estado de aprobación solo se cambian
    // desde la consola de Firebase (por eso no se permite modificarlos aquí).
    match /users/{userId} {
      allow read: if signedIn();
      // El conductor debe enviar el registro completo, incluida la aceptación
      // de términos y la capacidad del vehículo (XL exige mínimo 6).
      allow create: if signedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role != 'driver'
          || (
            request.resource.data.acceptedTerms == true
            && request.resource.data.language in ['es', 'en']
            && request.resource.data.gender is string
            && request.resource.data.mercadoPagoEmail is string
            && request.resource.data.vehicle.capacity is int
            && request.resource.data.vehicle.capacity >= 1
            && (
              request.resource.data.vehicle.category != 'xl'
              || request.resource.data.vehicle.capacity >= 6
            )
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.approvalStatus == resource.data.approvalStatus;
      allow delete: if false;

      // Fotos del conductor: perfil, vehículo, licencia, SOAT y tecnomecánica.
      // Solo el dueño del perfil puede leerlas o reemplazarlas.
      match /documents/{documentId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.base64 is string
          && request.resource.data.base64.size() < 400000;
      }
    }

    // Viajes: los participantes leen, el pasajero crea y ambos actualizan.
    // Las transiciones de estado se validan en la app; para producción conviene
    // mover la máquina de estados a una Cloud Function.
    match /trips/{tripId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.participants == [request.auth.uid];

      allow update: if signedIn()
        && (
          resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || (
            resource.data.status == 'requested'
            && request.resource.data.driverId == request.auth.uid
          )
          // Rechazar: el conductor se agrega a rejectedBy y el viaje sigue
          // disponible para los demás.
          || (
            resource.data.status == 'requested'
            && resource.data.passengerId != request.auth.uid
            && request.resource.data.status == 'requested'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejectedBy'])
            && request.auth.uid in request.resource.data.rejectedBy
          )
        )
        // El método de pago se elige al pedir el viaje y ya no cambia.
        && (
          request.resource.data.paymentMethod == resource.data.paymentMethod
          || resource.data.status == 'requested'
        )
        // Los datos del recorrido y de la cotización quedan congelados al crear
        // el viaje: ni el pasajero ni el conductor pueden alterarlos después.
        && request.resource.data.passengerId == resource.data.passengerId
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.destination == resource.data.destination
        && request.resource.data.distanceKm == resource.data.distanceKm
        && request.resource.data.durationMin == resource.data.durationMin
        && request.resource.data.category == resource.data.category
        && request.resource.data.tip == resource.data.tip
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.commissionRate == resource.data.commissionRate
        // La tarifa solo se recalcula al finalizar el viaje, y solo por el
        // conductor asignado.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['fare', 'commission', 'driverEarnings'])
          || (
            resource.data.driverId == request.auth.uid
            && resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
          )
        )
        // Los campos de pago con tarjeta real solo los escribe el webhook (Admin
        // SDK). En efectivo el conductor confirma el cobro desde la app y en el
        // modo de prueba el pasajero simula el resultado: aprobado -> paid, o
        // rechazado sin cambiar el estado del viaje.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paymentStatus', 'paymentId', 'paymentAmount', 'paidAt', 'paymentPreferenceId'])
          || resource.data.paymentMethod == 'cash'
          || (
            resource.data.paymentMethod == 'mercadopago_test'
            && resource.data.passengerId == request.auth.uid
            && (
              (
                request.resource.data.paymentStatus == 'approved'
                && request.resource.data.status == 'paid'
              )
              || (
                request.resource.data.paymentStatus == 'rejected'
                && request.resource.data.status == 'completed'
              )
            )
          )
        )
        // La calificación la escribe el pasajero, solo cuando el viaje terminó
        // y con un entero de 1 a 5 estrellas.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rating', 'ratedAt'])
          || (
            resource.data.passengerId == request.auth.uid
            && resource.data.status in ['completed', 'paid']
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
          )
        );

      allow delete: if false;
    }
  }
}
